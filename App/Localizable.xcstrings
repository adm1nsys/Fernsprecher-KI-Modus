    "(nothing recognised – try a little closer to the mic)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(nichts erkannt – geh etwas näher ans Mikrofon)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(rien reconnu – rapprochez-vous un peu du micro)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "(intet genkendt – prøv lidt tættere på mikrofonen)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（認識できませんでした。もう少しマイクに近づいてください）"
          }
        }
      }
    },
