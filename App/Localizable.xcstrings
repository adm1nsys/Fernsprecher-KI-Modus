    "Microphone access is off. Allow it in System Settings → Privacy & Security → Microphone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff ist aus. Erlaube den Zugriff unter Systemeinstellungen → Datenschutz & Sicherheit → Mikrofon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au micro est désactivé. Autorisez-le dans Réglages Système → Confidentialité et sécurité → Microphone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til mikrofonen er slået fra. Tillad den i Systemindstillinger → Anonymitet & sikkerhed → Mikrofon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスがオフです。システム設定 → プライバシーとセキュリティ → マイク で許可してください。"
          }
        }
      }
    },
    "Models": {
      "localizations": {
