    "Light and quick. Fine for clear speech in a quiet room.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leicht und flott. Reicht für deutliche Aussprache in einem ruhigen Raum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Léger et rapide. Suffisant pour une diction claire dans une pièce calme."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Let og hurtig. Fin til tydelig tale i et stille rum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軽くて速い。静かな部屋ではっきり話すなら十分。"
          }
        }
      }
    },
