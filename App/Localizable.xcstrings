          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin steht noch nicht in deinem PATH, deshalb findet die Shell den Befehl nicht. Füge diese Zeile in ~/.zprofile ein:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin n’est pas encore dans votre PATH : le shell ne trouvera pas la commande. Ajoutez cette ligne à ~/.zprofile :"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin er endnu ikke i din PATH, så shellen kan ikke finde kommandoen. Tilføj denne linje til ~/.zprofile:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin がまだ PATH に入っていないため、シェルがコマンドを見つけられません。~/.zprofile にこの行を追加してください："
          }
        }
      }
    },
