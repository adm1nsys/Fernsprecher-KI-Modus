    "More Apple voices (including Japanese): System Settings → Accessibility → Spoken Content → System Voice → Manage Voices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitere Apple-Stimmen (auch Japanisch): Systemeinstellungen → Bedienungshilfen → Gesprochene Inhalte → Systemstimme → Stimmen verwalten."
          }
        },
