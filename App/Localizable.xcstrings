    "Best all-rounder. About a second per phrase on Apple silicon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der beste Allrounder. Auf Apple Silicon etwa eine Sekunde pro Satz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le meilleur polyvalent. Environ une seconde par phrase sur puce Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det bedste allround-valg. Cirka et sekund pr. sætning på Apple Silicon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "万能タイプ。Appleシリコンで1フレーズ約1秒。"
